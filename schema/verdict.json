{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "flags", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "unsure"],
      "description": "pass only if every change in the evidence is understood and safe for this repository; unsure if anything could not be checked."
    },
    "flags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "network-access-added",
          "process-execution-added",
          "filesystem-access-added",
          "credential-or-env-access",
          "obfuscated-or-encoded-code",
          "build-or-install-hook-changed",
          "new-dependency",
          "maintainer-or-publisher-change",
          "behavior-change-affects-repo",
          "api-incompatibility",
          "default-changed",
          "security-fix-incomplete",
          "evidence-incomplete",
          "instructions-in-data"
        ]
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 3000,
      "description": "Plain-text reasoning a human can audit: what was diffed, what changed, how the repository uses it, and the decision. No links, no @-mentions, no markdown headings."
    }
  }
}
