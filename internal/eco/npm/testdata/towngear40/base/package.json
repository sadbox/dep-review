{
  "name": "towngear",
  "version": "1.0.0",
  "description": "Tailwind stylesheet build for the Towngear web app",
  "author": "James McGuire",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i input.css -o internal/web/static/style.css --minify",
    "build:js": "esbuild input.js --bundle --minify --outfile=internal/web/static/app.js"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5"
  }
}
