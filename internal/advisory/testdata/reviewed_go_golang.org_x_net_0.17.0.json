ed_at":"2025-03-12T22:06:40Z","nvd_published_at":"2025-03-12T19:15:38Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"go","name":"golang.org/x/net"},"vulnerable_version_range":"< 0.36.0","first_patched_version":"0.36.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:L","score":4.4},"cvss_v4":{"vector_string":null,"score":0.0}},"cwes":[{"cwe_id":"CWE-20","name":"Improper Input Validation"},{"cwe_id":"CWE-115","name":"Misinterpretation of Input"}],"credits":[],"comments":0,"cvss":{"vector_string":"CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:L/I:N/A:L","score":4.4},"epss":{"percentage":0.00425,"percentile":0.37508}},{"ghsa_id":"GHSA-4v7x-pqxf-cx7m","cve_id":"CVE-2023-45288","url":"https://api.github.com/advisories/GHSA-4v7x-pqxf-cx7m","html_url":"https://github.com/advisories/GHSA-4v7x-pqxf-cx7m","summary":"net/http, x/net/http2: close connections when receiving too many headers","description":"An attacker may cause an HTTP/2 endpoint to read arbitrary amounts of header data by sending an excessive number of CONTINUATION frames. Maintaining HPACK state requires parsing and processing all HEADERS and CONTINUATION frames on a connection. When a request's headers exceed MaxHeaderBytes, no memory is allocated to store the excess headers, but they are still parsed. This permits an attacker to cause an HTTP/2 endpoint to read arbitrary amounts of header data, all associated with a request which is going to be rejected. These headers can include Huffman-encoded data which is significantly more expensive for the receiver to decode than for an attacker to send. The fix sets a limit on the amount of excess header frames we will process before closing a connection.","type":"reviewed","severity":"medium","repository_advisory_url":null,"source_code_location":"","identifiers":[{"value":"GHSA-4v7x-pqxf-cx7m","type":"GHSA"},{"value":"CVE-2023-45288","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/d